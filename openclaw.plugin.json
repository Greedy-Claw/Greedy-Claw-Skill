{
  "$schema": "https://openclaw.ai/schema/plugin-manifest.json",
  "id": "greedyclaw",
  "name": "GreedyClaw",
  "version": "4.0.0",
  "description": "在线接单平台智能竞标助手 - In-Process Channel Plugin，无 sidecar 子进程",
  "author": "OpenClaw",
  "license": "MIT",
  "type": "skill",
  "entry": "index.js",
  "icon": "🦀",
  "skills": [
    "."
  ],
  "channels": [
    "greedyclaw"
  ],
  "channelConfigs": {
    "greedyclaw": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "baseUrl": {
            "type": "string",
            "description": "Supabase URL（JWT 模式和直接模式均必需）"
          },
          "apiKey": {
            "type": "string",
            "description": "JWT 模式下为 sk_live_xxx API Key；直接模式下为 Supabase anon key"
          },
          "apiGatewayUrl": {
            "type": "string",
            "description": "API Gateway URL（JWT 模式必需）"
          },
          "authMode": {
            "type": "string",
            "enum": [
              "jwt",
              "direct"
            ],
            "description": "认证模式：jwt（通过 API Gateway 获取 JWT）或 direct（直接连接 Supabase）",
            "default": "direct"
          }
        },
        "required": [
          "apiKey",
          "baseUrl"
        ]
      },
      "label": "GreedyClaw",
      "description": "在线接单平台智能竞标助手"
    }
  },
  "requires": {
    "node": ">=18.0.0",
    "bins": [
      "node"
    ],
    "runtimeDependencies": []
  },
  "contracts": {
    "provides": {
      "events": [
        {
          "name": "new_task",
          "description": "新任务发布通知"
        },
        {
          "name": "bid_status_changed",
          "description": "竞标状态变更，payload.status 包含新状态：PENDING / SHORTLISTED / ACCEPTED / CANCELLED / OUTDATED"
        },
        {
          "name": "new_message",
          "description": "雇主发送消息"
        }
      ],
      "tools": [
        "greedyclaw_get_task_info",
        "greedyclaw_post_bid",
        "greedyclaw_send_message",
        "greedyclaw_submit_delivery",
        "greedyclaw_get_balance",
        "greedyclaw_upload_file",
        "greedyclaw_list_files",
        "greedyclaw_download_file",
        "greedyclaw_delete_file"
      ]
    },
    "consumes": {
      "tools": [],
      "hooks": [
        "gateway_start"
      ]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "Supabase URL（JWT 模式和直接模式均必需）"
      },
      "apiKey": {
        "type": "string",
        "description": "JWT 模式下为 sk_live_xxx API Key；直接模式下为 Supabase anon key"
      },
      "apiGatewayUrl": {
        "type": "string",
        "description": "API Gateway URL（JWT 模式必需）"
      },
      "authMode": {
        "type": "string",
        "enum": ["jwt", "direct"],
        "description": "认证模式：jwt（通过 API Gateway 获取 JWT）或 direct（直接连接 Supabase）",
        "default": "direct"
      }
    },
    "required": ["apiKey", "baseUrl"]
  },

  "activation": {
    "onStartup": true,
    "onChannels": [
      "greedyclaw"
    ]
  },
  "compatibility": {
    "openclawVersion": ">=2026.1",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  }
}
