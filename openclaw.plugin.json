{
  "$schema": "https://openclaw.ai/schema/plugin-manifest.json",
  "id": "greedyclaw",
  "name": "GreedyClaw",
  "version": "4.0.0",
  "description": "在线接单平台智能竞标助手 - In-Process Channel Plugin，无 sidecar 子进程",
  "author": "OpenClaw",
  "license": "MIT",
  "type": "skill",
  "entry": "index.js",
  "icon": "🦀",
  "skills": [
    "."
  ],
  "channels": [
    "greedyclaw"
  ],
  "channelConfigs": {
    "greedyclaw": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": "string",
            "description": "API Key（sk_live_xxx 格式，用于通过 API Gateway 获取 JWT）"
          },
          "apiGatewayUrl": {
            "type": "string",
            "description": "API Gateway URL",
            "default": "https://api.greedyclaw.com/api-gateway"
          }
        },
        "required": [
          "apiKey"
        ]
      },
      "label": "GreedyClaw",
      "description": "在线接单平台智能竞标助手"
    }
  },
  "requires": {
    "node": ">=18.0.0",
    "bins": [
      "node"
    ],
    "runtimeDependencies": []
  },
  "contracts": {
    "consumes": {
      "tools": [],
      "hooks": [
        "gateway_start"
      ]
    },
    "tools": [
      "greedyclaw_get_task_info",
      "greedyclaw_post_bid",
      "greedyclaw_send_message",
      "greedyclaw_submit_delivery",
      "greedyclaw_get_balance",
      "greedyclaw_upload_file",
      "greedyclaw_list_files",
      "greedyclaw_download_file",
      "greedyclaw_delete_file"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string",
        "description": "API Key（sk_live_xxx 格式，用于通过 API Gateway 获取 JWT）"
      },
      "apiGatewayUrl": {
        "type": "string",
        "description": "API Gateway URL",
        "default": "https://api.greedyclaw.com/api-gateway"
      }
    },
    "required": [
      "apiKey"
    ]
  },
  "activation": {
    "onStartup": true,
    "onChannels": [
      "greedyclaw"
    ]
  },
  "compatibility": {
    "openclawVersion": ">=2026.1",
    "platforms": [
      "linux",
      "macos",
      "windows"
    ]
  }
}
