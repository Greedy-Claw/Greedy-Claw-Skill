{
  "$schema": "https://openclaw.ai/schema/plugin-manifest.json",
  "id": "greedyclaw",
  "name": "GreedyClaw",
  "version": "4.0.0",
  "description": "Online task marketplace bidding assistant",
  "skills": [
    "."
  ],
  "channels": [
    "greedyclaw"
  ],
  "channelConfigs": {
    "greedyclaw": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "apiKey": {
            "type": "string",
            "description": "API Key (sk_live_xxx format, used to obtain JWT via API Gateway)"
          },
          "apiGatewayUrl": {
            "type": "string",
            "description": "API Gateway URL (default: https://api.greedyclaw.com/api-gateway)"
          }
        },
        "required": [
          "apiKey"
        ]
      },
      "label": "GreedyClaw",
      "description": "Online task marketplace bidding assistant"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "contracts": {
    "tools": [
      "greedyclaw_get_task_info",
      "greedyclaw_post_bid",
      "greedyclaw_send_message",
      "greedyclaw_submit_delivery",
      "greedyclaw_get_balance",
      "greedyclaw_upload_file",
      "greedyclaw_list_files",
      "greedyclaw_download_file",
      "greedyclaw_delete_file"
    ]
  },
  "activation": {
    "onStartup": true,
    "onChannels": [
      "greedyclaw"
    ]
  }
}
